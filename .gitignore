# real Garmin data snapshots (MCP pull) — local-only, optional richer
# datasets for local dev. The non-.local counterparts (the tracked
# paths lib/data.js reads) are small synthetic samples instead.
src/data/activities.local.json
src/data/wellness.local.json
src/data/vo2MaxTrend.local.json
src/data/weighIns.local.json

# hand-entered real golf rounds — no Garmin sync path exists for these
# (the garmin MCP server has no golf endpoints), so this file is maintained
# by hand and never committed. Note the `*.local` glob above does NOT match
# `*.local.json` — every real dataset has to be listed by name.
src/data/golfRounds.local.json

# cumulative local SQLite store the sync script upserts into — see
# scripts/sync_garmin.py. Real Garmin data, never committed.
scripts/*.local.db
scripts/*.log
